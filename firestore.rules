rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth != null ? request.auth.uid : ''; }
    function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)).data; }
    function isCR() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid())) && userDoc(uid()).role == 'cr';
    }
    function isOwner(u) { return signedIn() && uid() == u; }
    function validRoll(r) { return r.matches('^(0[1-9]|1[0-9]|2[0-4])$'); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'student'
        && validRoll(request.resource.data.rollNo);
      allow update: if isCR() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rollNo', 'email']));
      allow delete: if false;
    }

    match /attendance/{rollNo} {
      allow read: if signedIn();
      allow write: if isCR() || (signedIn() && userDoc(uid()).rollNo == rollNo
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended', 'total']));
    }

    match /timetable/{day} {
      allow read: if signedIn();
      allow write: if isCR();
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create: if isCR() && request.resource.data.isUrgent is bool;
      allow update: if isCR() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && uid() in request.resource.data.readBy);
      allow delete: if isCR();
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploaderUid == uid();
      allow update, delete: if isCR() || (signedIn() && resource.data.uploaderUid == uid());
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if isCR();
      allow update: if signedIn() && !(uid() in resource.data.votedUserIds)
        && uid() in request.resource.data.votedUserIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedUserIds', 'votes']);
      allow delete: if isCR();
    }

    match /grievances/{issueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.upvotedBy.size() == 0;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotedBy'])
          && !(uid() in resource.data.upvotedBy) && uid() in request.resource.data.upvotedBy)
        || (isCR() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']))
      );
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isCR() || (signedIn() && resource.data.ownerUid == uid());
      allow delete: if false;
    }

    match /teammates/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    match /aiUsage/{usageId} {
      allow read, write: if signedIn() && usageId.matches(uid() + '_.*');
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if isCR();
      allow update, delete: if false;
    }
  }
}
