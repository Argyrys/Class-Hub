# Firebase web config (public values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Mock prototype CR account
VITE_CR_EMAIL=cr@batch.test

# Server-only Groq key. Never prefix with VITE_.
# Production: firebase functions:secrets:set GROQ_API_KEY
# Local dev: put GROQ_API_KEY in .env.local; Vite uses it server-side only.
# GROQ_API_KEY=
